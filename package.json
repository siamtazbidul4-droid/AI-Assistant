{
  "name": "ai-studio-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "front-end",
    "back-end"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace front-end run dev",
    "dev:backend": "npm --workspace back-end run dev",
    "build:frontend": "npm --workspace front-end run build",
    "build:backend": "npm --workspace back-end run build",
    "start:backend": "npm --workspace back-end run start",
    "typecheck:frontend": "npm --workspace front-end run typecheck",
    "typecheck:backend": "npm --workspace back-end run build"
  }
}
